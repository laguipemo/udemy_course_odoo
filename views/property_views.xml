      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "tree,form",
          "res_model": model._name,
        }
      </field>
    </record>
-->

    <!-- Top menu item -->
    <menuitem name="Property Ads" id="real_estate_ads_menu_root" web_icon="real_estate_ads,static/description/icon.png"/>

    <!-- menu categories -->
    <menuitem name="Ads" id="real_estate_ads_menu_ads" parent="real_estate_ads_menu_root"/>
    <!--<menuitem name="Menu 2" id="real_estate_ads.menu_2" parent="real_estate_ads.menu_root"/>-->

    <!-- actions -->
    <menuitem name="Property" id="real_estate_ads_menu_ads_property" parent="real_estate_ads_menu_ads"
              action="real_estate_ads_property_action_window"/>
    <!--<menuitem name="Server to list" id="real_estate_ads" parent="real_estate_ads.menu_2"
              action="real_estate_ads.action_server"/>-->
  </data>
</odoo>