<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="real_estate_ads_property_list_view">
      <field name="name">real_estate_ads property list</field>
      <field name="model">real_estate_ads.property</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="postcode"/>
          <field name="date_availability"/>
          <field name="expected_price" optional="hide" />
          <field name="best_offer"/>
          <field name="selling_price"/>
        </tree>
      </field>
    </record>

    <!-- explicit form view definition -->
    <record model="ir.ui.view" id="real_estate_ads_property_form_view">
      <field name="name">real_estate_ads property form</field>
      <field name="model">real_estate_ads.property</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <group>
                <field name="postcode"/>
                <field name="date_availability"/>
              </group>
              <group>
                <field name="expected_price"/>
                <field name="best_offer"/>
                <field name="selling_price"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="real_estate_ads_property_action_window">
      <field name="name">Property</field>
      <field name="res_model">real_estate_ads.property</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="real_estate_ads.real_estate_ads_property_list_view" />
      <field name="help" type="html">
        <p class="o.view_nocontent_smiling_face">
          Create a Property to Advertise
        </p>
      </field>
    </record>

    <!-- server action to the one above -->
<!--
    <record model="ir.actions.server" id="real_estate_ads.action_server">
      <field name="name">real_estate_ads server</field>
      <field name="model_id" ref="model_real_estate_ads_real_estate_ads"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "tree,form",
          "res_model": model._name,
        }
      </field>
    </record>
-->

    <!-- Top menu item -->
    <menuitem name="Property Ads" id="real_estate_ads_menu_root" web_icon="real_estate_ads,static/description/icon.png"/>

    <!-- menu categories -->
    <menuitem name="Ads" id="real_estate_ads_menu_ads" parent="real_estate_ads_menu_root"/>
    <!--<menuitem name="Menu 2" id="real_estate_ads.menu_2" parent="real_estate_ads.menu_root"/>-->

    <!-- actions -->
    <menuitem name="Property" id="real_estate_ads_menu_ads_property" parent="real_estate_ads_menu_ads"
              action="real_estate_ads_property_action_window"/>
    <!--<menuitem name="Server to list" id="real_estate_ads" parent="real_estate_ads.menu_2"
              action="real_estate_ads.action_server"/>-->
  </data>
</odoo>