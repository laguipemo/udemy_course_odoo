<odoo>
  <data>
    <record model="ir.actions.act_window" id="real_estate_ads_property_show_offers_action_window">
      <field name="name">Offers</field>
      <field name="res_model">real_estate_ads.property_offer</field>
      <field name="domain">[('property_id', '=', active_id)]</field>
      <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.ui.view" id="real_estate_ads_property_search_view">
      <field name="name">real_estate_ads property search</field>
      <field name="model">real_estate_ads.property</field>
      <field name="arch" type="xml">
        <search>
          <field name="name"/>
          <field name="state"/>
          <field name="postcode"/>
          <field name="buyer_id"/>
          <filter string="New" name="new_state" domain="[('state', '=', 'new')]"/>
          <filter string="Sold" name="sold_state" domain="[('state', '=', 'sold')]"/>
          <separator/>
          <filter string="Received" name="received_state" domain="[('state', '=', 'received')]"/>
          <filter string="Accepted" name="accepted_state" domain="[('state', '=', 'accepted')]"/>
          <filter string="Cancelled" name="cancel_state" domain="[('state', '=', 'cancel')]"/>
          <separator/>
          <filter string="Active" name="active_state" domain="[('state', 'not in', ['sold', 'cancel'])]"/>
          <separator/>
          <group expand="0" string="Group By">
            <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
          </group>
          <searchpanel>
            <field name="state" icon="fa fa-filter" group="group_by_state" limit="0" />
          </searchpanel>
        </search>
      </field>
    </record>

    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="real_estate_ads_property_list_view">
      <field name="name">real_estate_ads property list</field>
      <field name="model">real_estate_ads.property</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="type_id"/>
          <field name="postcode"/>
          <field name="date_availability"/>
          <field name="expected_price" optional="hide" />
          <field name="best_offer"/>
          <field name="selling_price"/>
          <field name="state" widget="badge"/>
        </tree>
      </field>
    </record>

    <!-- explicit form view definition -->
    <record model="ir.ui.view" id="real_estate_ads_property_form_view">
      <field name="name">real_estate_ads property form</field>
      <field name="model">real_estate_ads.property</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_sold" type="object" string="Sold" class="btn btn-primary"/>
            <button name="action_cancel" type="object" string="Cancel" class="btn btn-danger"/>
            <field name="state" widget="statusbar" /> <!-- statusbar_visible="new, receive" /> -->
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <!--<button class="oe_stat_button" name="%(real_estate_ads.real_estate_ads_property_show_offers_action_window)d" type="action" >-->
              <button class="oe_stat_button fa fa-handshake-o" name="action_real_estate_ads_property_show_offers_action_window" type="object" >
                <field name="offer_count" string="Offers" widget="statinfo" />
              </button>
            </div>
            <group>
              <field name="name" placeholder="Name of the property" widget="char_emojis"/>
              <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
              <separator/>
              <group>
                <field name="type_id"/>
                <field name="postcode"/>
                <field name="date_availability"/>
              </group>
              <group>
                <field name="expected_price"/>
                <field name="best_offer"/>
                <field name="selling_price"/>
              </group>
            </group>
            <notebook>
                <page string="Description">
                  <group>
                    <field name="description"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <field name="facades"/>
                    <field name="garage"/>
                    <field name="garden" widget="boolean_toggle"/>
                    <field name="garden_area" attrs="{'invisible': [('garden', '=', False)]}"/>
                    <field name="garden_orientation" attrs="{'invisible': [('garden', '=', False)]}" widget="selection_badge"/>
                    <field name="total_area"/>
                  </group>

                </page>
                <page string="Offers">
                  <field name="offer_ids">
                    <tree editable="bottom">
                      <field name="price"/>
                      <field name="partner_id"/>
                      <field name="property_id"/>
                      <field name="creation_date"/>
                      <field name="validity"/>
                      <field name="deadline" widget="remaining_days"/>
                      <field name="status" nolabel="1"/>
                    </tree>
                  </field>
                </page>
                <page string="Other Info">
                  <group>
                    <field name="sales_id" widget="many2one_avatar"/>
                    <field name="buyer_id"/>
                    <field name="phone" widget="phone" />
                  </group>
                </page>
              </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="real_estate_ads_property_action_window">
      <field name="name">Property</field>
      <field name="res_model">real_estate_ads.property</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="real_estate_ads.real_estate_ads_property_list_view" />
      <field name="help" type="html">
        <p class="o.view_nocontent_smiling_face">
          Create a Property to Advertise
        </p>
      </field>
    </record>

    <!-- server action to the one above -->
