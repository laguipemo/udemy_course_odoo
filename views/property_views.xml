<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="real_estate_ads_property_list_view">
      <field name="name">real_estate_ads property list</field>
      <field name="model">real_estate_ads.property</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="type_id"/>
          <field name="postcode"/>
          <field name="date_availability"/>
          <field name="expected_price" optional="hide" />
          <field name="best_offer"/>
          <field name="selling_price"/>
        </tree>
      </field>
    </record>

    <!-- explicit form view definition -->
    <record model="ir.ui.view" id="real_estate_ads_property_form_view">
      <field name="name">real_estate_ads property form</field>
      <field name="model">real_estate_ads.property</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name" placeholder="Name of the property"/>
              <field name="tag_ids" widget="many2many_tags"/>
              <separator/>
              <group>
                <field name="type_id"/>
                <field name="postcode"/>
                <field name="date_availability"/>
              </group>
              <group>
                <field name="expected_price"/>
                <field name="best_offer"/>
                <field name="selling_price"/>
              </group>
            </group>
            <notebook>
                <page string="Description">
                  <group>
                    <field name="description"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <field name="facades"/>
                    <field name="garage"/>
                    <field name="garden"/>
                    <field name="garden_area"/>
                    <field name="garden_orientation"/>
                    <field name="total_area"/>
                  </group>

                </page>
                <page string="Offers">
                  <field name="offer_ids">
                    <tree editable="bottom">
                      <field name="price"/>
                      <field name="partner_id"/>
                      <field name="property_id"/>
                      <field name="creation_date"/>
                      <field name="validity"/>
                      <field name="deadline"/>
                      <field name="status" nolabel="1"/>
                    </tree>
                  </field>
                </page>
                <page string="Other Info">
                  <group>
                    <field name="sales_id"/>
                    <field name="buyer_id"/>
                  </group>
                </page>
              </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="real_estate_ads_property_action_window">
      <field name="name">Property</field>
      <field name="res_model">real_estate_ads.property</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="real_estate_ads.real_estate_ads_property_list_view" />
      <field name="help" type="html">
        <p class="o.view_nocontent_smiling_face">
          Create a Property to Advertise
        </p>
      </field>
    </record>

    <!-- server action to the one above -->
