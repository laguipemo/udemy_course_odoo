<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="real_estate_ads_property_offer_list_view">
      <field name="name">real_estate_ads property offer list</field>
      <field name="model">real_estate_ads.property_offer</field>
      <field name="arch" type="xml">
        <tree decoration-success="status == 'accepted'" decoration-danger="status == 'refused'">
          <field name="name" />
          <field name="price" />
          <field name="status" />
          <field name="partner_id" />
          <field name="property_id" />
          <field name="creation_date" />
          <field name="validity" />
          <field name="deadline" widget="remaining_days"/>
        </tree>
      </field>
    </record>

    <!-- explicit gantt view definition only visible for Enterprise version -->
    <record model="ir.ui.view" id="real_estate_ads_property_offer_gantt_view">
      <field name="name">real_estate_ads property offer gantt</field>
      <field name="model">real_estate_ads.property_offer</field>
      <field name="arch" type="xml">
        <gantt date_start="creation_date" date_end="deadline" default_group_by="partner_id"/>
      </field>
    </record>

    <!-- explicit form view definition -->
    <record model="ir.ui.view" id="real_estate_ads_property_offer_form_view">
      <field name="name">real_estate_ads property offer form</field>
      <field name="model">real_estate_ads.property_offer</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="name" />
                <field name="price" />
                <field name="status" />
                <field name="partner_id" />
                <field name="property_id" />
              </group>
              <group>
                <field name="creation_date" />
                <field name="validity" />
                <field name="deadline" />
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="real_estate_ads_property_offer_action_window">
      <field name="name">Property Offer</field>
      <field name="res_model">real_estate_ads.property_offer</field>
      <field name="view_mode">tree,gantt,form</field>
    </record>

