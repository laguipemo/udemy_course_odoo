<odoo>
  <data>
    <!-- explicit list view definition -->
    <record model="ir.ui.view" id="real_estate_ads_property_tag_list_view">
      <field name="name">real_estate_ads property tag list</field>
      <field name="model">real_estate_ads.property_tag</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="color" widget="color_picker"/>
        </tree>
      </field>
    </record>

    <!-- explicit form view definition -->
    <record model="ir.ui.view" id="real_estate_ads_property_tag_form_view">
      <field name="name">real_estate_ads property tag form</field>
      <field name="model">real_estate_ads.property_tag</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="color" widget="color_picker"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="real_estate_ads_property_tag_action_window">
      <field name="name">Property Tag</field>
      <field name="res_model">real_estate_ads.property_tag</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="real_estate_ads.real_estate_ads_property_tag_list_view" />
      <field name="help" type="html">
        <p class="o.view_nocontent_smiling_face">
          Create a Property to Advertise
        </p>
      </field>
    </record>

    <!-- server action to the one above -->
