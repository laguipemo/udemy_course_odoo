<odoo>
    <!-- New category for real estate ads module users permissions access -->
    <record model="ir.module.category" id="real_estate_ads_module_category">
        <field name="name">Real Estate Ads</field>
        <field name="description">Helps you handle properties and offers</field>
        <field name="sequence">50</field>
    </record>

    <!-- New group for real estate ads module, users -->
    <record model="res.groups" id="real_estate_ads_property_group_users">
        <field name="name">User: Manage own property</field>
        <field name="category_id" ref="real_estate_ads.real_estate_ads_module_category" />
        <field name="comment">Usuarios que pueden gestionar sus propiedades</field>
        <!-- Add the same permissions that have the users of the group "base.group_user" -->
        <!-- <field name="users" eval="[(4,ref('base.group_user'))]" /> -->
        <field name="implied_ids" eval="[(4,ref('base.group_user'))]" />
        <!-- Add a specific user to this group, linking its ID by example "base.user_demo" -->
        <field name="users" eval="[Command.link(ref('base.user_demo'))]" />
    </record>

    <!-- New group for real estate ads module, administrators -->
    <record model="res.groups" id="real_estate_ads_property_group_admins">
        <field name="name">Admin: Manage all properties</field>
        <field name="category_id" ref="real_estate_ads.real_estate_ads_module_category" />
        <field name="comment">Usuarios que pueden gestionar todas las propiedades</field>
        <!-- Add the same permissions that have the users of the group "base.group_user" -->
        <field name="implied_ids" eval="[(4,ref('real_estate_ads_property_group_users'))]" />
        <!-- Add the same permissions that have the users of the group "base.user_admin" -->
        <field name="users" eval="[(4,ref('base.user_admin'))]"/>
    </record>
